{
    "controllers": {
        "@pentiminax/ux-datatables": {
            "datatable": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@pentiminax/ux-datatables/dist/styles/datatables-base-style.css": true,
                    "@pentiminax/ux-datatables/dist/styles/datatables-tailwind-theme.css": false,
                    "datatables.net-dt/css/dataTables.dataTables.min.css": true,
                    "datatables.net-bs5/css/dataTables.bootstrap5.min.css": false,
                    "datatables.net-bs4/css/dataTables.bootstrap4.min.css": false,
                    "datatables.net-bs/css/dataTables.bootstrap.min.css": false
                }
            }
        },
        "@survos/iiif-bundle": {
            "iiif-viewer": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            },
            "iiif-diva": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            },
            "iiif-pdf": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/imgproxy-bundle": {
            "imgproxy": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/js-twig-bundle": {
            "dexie": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": []
            },
            "js_twig": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/meili-bundle": {
            "insta": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "instantsearch.css/themes/algolia.min.css": false,
                    "pretty-print-json/dist/css/pretty-print-json.min.css": true
                }
            },
            "json": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            },
            "chat": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": {
                    "@survos/meili/styles/chat.css": true
                }
            }
        },
        "@survos/simple-datatables-bundle": {
            "table": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": {
                    "@survos/simple-datatables-bundle/style.css": true
                }
            },
            "ux": {
                "enabled": true,
                "fetch": "lazy"
            }
        },
        "@survos/state-bundle": {
            "workflow": {
                "enabled": true,
                "fetch": "eager"
            }
        },
        "@survos/tabler-bundle": {
            "accordion": {
                "enabled": true,
                "fetch": "lazy"
            },
            "search": {
                "enabled": true,
                "fetch": "lazy"
            },
            "clipboard": {
                "enabled": true,
                "fetch": "lazy"
            },
            "closeable": {
                "enabled": true,
                "fetch": "lazy"
            },
            "tooltip": {
                "enabled": true,
                "fetch": "lazy"
            },
            "conditional-fields": {
                "enabled": true,
                "fetch": "lazy"
            }
        },
        "@symfony/ux-leaflet-map": {
            "map": {
                "enabled": true,
                "fetch": "lazy"
            }
        }
    },
    "entrypoints": []
}
